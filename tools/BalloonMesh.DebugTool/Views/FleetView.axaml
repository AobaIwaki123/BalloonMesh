<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BalloonMesh.DebugTool.ViewModels"
             x:Class="BalloonMesh.DebugTool.Views.FleetView"
             x:DataType="vm:MainWindowViewModel"
             x:CompileBindings="True">

    <Grid RowDefinitions="Auto,*" Margin="4">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <Button Content="Refresh" Command="{Binding RefreshCommand}" />
            <Button Content="Start demo" Command="{Binding StartDemoCommand}" />
            <Button Content="Stop demo" Command="{Binding StopDemoCommand}" />
            <TextBlock Text="{Binding SimulationStatusText}" VerticalAlignment="Center"
                       Classes="muted" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="3*,2*" Margin="0,8,0,0">
            <Border Grid.Column="0" Classes="card" Margin="0,0,8,0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Row="0" Classes="h2" Text="Balloons" />
                    <Grid Grid.Row="1">
                        <Grid RowDefinitions="Auto,*">
                            <Grid ColumnDefinitions="100,58,80,88,88,22,54,52" Margin="4,0">
                                <TextBlock Text="Name" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="Address" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="Group" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="Lat" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="4" Text="Lon" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="5" Text="RGB" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="6" Text="Queue" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="7" Text="Online" FontWeight="SemiBold" />
                            </Grid>
                            <ListBox Grid.Row="1" Margin="0,4,0,0"
                                     ItemsSource="{Binding Balloons}"
                                     SelectedItem="{Binding SelectedBalloon}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BalloonRowViewModel">
                                        <Grid ColumnDefinitions="100,58,80,88,88,22,54,52"
                                              Height="24">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding AddressText}" />
                                            <TextBlock Grid.Column="2" Text="{Binding GroupName}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3" Text="{Binding LatText}" />
                                            <TextBlock Grid.Column="4" Text="{Binding LonText}" />
                                            <Border Grid.Column="5" Width="16" Height="16"
                                                    CornerRadius="8"
                                                    Background="{Binding ColorBrush}"
                                                    ToolTip.Tip="{Binding ColorHex}"
                                                    HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="6" Text="{Binding QueueText}" />
                                            <TextBlock Grid.Column="7" Text="{Binding OnlineText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                    <TextBlock Grid.Row="2" Text="{Binding BalloonSummary}" Classes="muted"
                               TextWrapping="Wrap" Margin="0,6,0,0" />
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="*,*">
                <Border Classes="card" Margin="0,0,0,4">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <TextBlock Classes="h2" Text="Gateways" />
                        <Grid Grid.Row="1">
                            <Grid RowDefinitions="Auto,*">
                                <Grid ColumnDefinitions="110,44,150,60,50,40" Margin="4,0">
                                    <TextBlock Text="Id" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Path" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="Last seen" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="Pending" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="4" Text="Prov." FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="5" Text="Spool" FontWeight="SemiBold" />
                                </Grid>
                                <ListBox Grid.Row="1" Margin="0,4,0,0"
                                         ItemsSource="{Binding Gateways}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:GatewayRowViewModel">
                                            <Grid ColumnDefinitions="110,44,150,60,50,40" Height="24">
                                                <TextBlock Text="{Binding Id}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding TransportText}" />
                                                <TextBlock Grid.Column="2" Text="{Binding LastSeenText}" />
                                                <TextBlock Grid.Column="3" Text="{Binding PendingText}" />
                                                <TextBlock Grid.Column="4" Text="{Binding ProvisionedText}" />
                                                <TextBlock Grid.Column="5" Text="{Binding SpoolText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>
                        <TextBlock Grid.Row="2" Text="{Binding GatewaySummary}" Classes="muted"
                                   Margin="0,6,0,0" />
                    </Grid>
                </Border>

                <Border Grid.Row="1" Classes="card" Margin="0,4,0,0">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <TextBlock Classes="h2" Text="Show steps" />
                        <Grid Grid.Row="1">
                            <Grid RowDefinitions="Auto,*">
                                <Grid ColumnDefinitions="36,90,90,170,20,55,50" Margin="4,0">
                                    <TextBlock Text="Id" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Name" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="Target" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="Execute at (UTC)" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="4" Text="RGB" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="5" Text="Status" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="6" Text="" />
                                </Grid>
                                <ListBox Grid.Row="1" Margin="0,4,0,0"
                                         ItemsSource="{Binding ShowSteps}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ShowStepRowViewModel">
                                            <Grid ColumnDefinitions="36,90,90,170,20,55,50" Height="26">
                                                <TextBlock Text="{Binding Id}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{Binding Target}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="3" Text="{Binding ExecuteAtText}" />
                                                <Border Grid.Column="4" Width="14" Height="14"
                                                        CornerRadius="7"
                                                        Background="{Binding ColorBrush}"
                                                        ToolTip.Tip="{Binding ColorHex}" />
                                                <TextBlock Grid.Column="5" Text="{Binding Status}" />
                                                <Button Grid.Column="6" Content="Cancel" Padding="6,1"
                                                        Command="{Binding CancelCommand}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>
                        <TextBlock Grid.Row="2" Text="{Binding ShowStepSummary}" Classes="muted"
                                   Margin="0,6,0,0" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
