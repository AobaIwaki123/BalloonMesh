<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BalloonMesh.DebugTool.ViewModels"
             x:Class="BalloonMesh.DebugTool.Views.DecodedLogView"
             x:DataType="vm:MainWindowViewModel"
             x:CompileBindings="True">

    <Grid RowDefinitions="Auto,*,Auto" Margin="4">
        <WrapPanel Grid.Row="0" Orientation="Horizontal">
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,12,6">
                <TextBlock Text="Direction" VerticalAlignment="Center" />
                <ComboBox Width="110" ItemsSource="{Binding DecodedDirections}"
                          SelectedItem="{Binding DecodedDirectionFilter}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,12,6">
                <TextBlock Text="Transport" VerticalAlignment="Center" />
                <ComboBox Width="120" ItemsSource="{Binding DecodedTransports}"
                          SelectedItem="{Binding DecodedTransportFilter}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,12,6">
                <TextBlock Text="Search" VerticalAlignment="Center" />
                <TextBox Width="220" Text="{Binding DecodedSearch}"
                         PlaceholderText="opcode / name / field / raw" />
            </StackPanel>
            <Button Content="Clear" Command="{Binding ClearDecodedLogCommand}"
                    Margin="0,0,8,6" />
            <Button Content="Save..." Click="OnSaveClick" Margin="0,0,8,6" />
            <TextBlock Text="TX / RX / manual decode, up to 1000 entries"
                       Classes="muted" VerticalAlignment="Center" Margin="0,0,0,6" />
        </WrapPanel>

        <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="0,4,0,0">
            <Grid ColumnDefinitions="80,60,80,100,120,*" Margin="4,0">
                <TextBlock Text="Time" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="Dir" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Text="Transport" FontWeight="SemiBold" />
                <TextBlock Grid.Column="3" Text="Opcode" FontWeight="SemiBold" />
                <TextBlock Grid.Column="4" Text="Name" FontWeight="SemiBold" />
                <TextBlock Grid.Column="5" Text="Decoded fields" FontWeight="SemiBold" />
            </Grid>
            <ListBox Grid.Row="1" Margin="0,4,0,0"
                     ItemsSource="{Binding DecodedLogView}"
                     SelectedItem="{Binding SelectedDecodedEntry}"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:DecodedLogEntryViewModel">
                        <Grid ColumnDefinitions="80,60,80,100,120,*" Height="24"
                              ToolTip.Tip="{Binding RawJson}">
                            <TextBlock Text="{Binding TimeText}" />
                            <TextBlock Grid.Column="1" Text="{Binding Direction}" />
                            <TextBlock Grid.Column="2" Text="{Binding Transport}" />
                            <TextBlock Grid.Column="3" Text="{Binding OpcodeText}" />
                            <TextBlock Grid.Column="4" Text="{Binding Name}" />
                            <TextBlock Grid.Column="5" Text="{Binding Fields}"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Border Grid.Row="2" Classes="card" Margin="0,8,0,0">
            <Grid RowDefinitions="Auto,150">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="h2" Text="Raw JSON / frame" />
                    <TextBlock Text="{Binding SelectedDecodedEntry.RawJsonLabel}"
                               Classes="muted" VerticalAlignment="Center" />
                </StackPanel>
                <TextBox Grid.Row="1" Text="{Binding SelectedDecodedEntry.RawJson}"
                         IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                         FontFamily="Cascadia Mono,Menlo,Consolas,monospace"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
